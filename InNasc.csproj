<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\InNasc.ico</ApplicationIcon>
    <AssemblyName>InNasc</AssemblyName>
    <RootNamespace>InNasc</RootNamespace>
    <Version>5.2.3</Version>
    <Authors>InN8 Labs</Authors>
    <Copyright>Copyright © 2026 InN8 Labs</Copyright>
    <Product>InNasc</Product>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="GlobalAdminProgram.cs" />
    <Compile Remove="InNascStartupForm.cs" />
    <Compile Remove="InNascCompanyAccessSyncService.cs" />
    <Compile Remove="InNascCompanyGlobalAdminService.cs" />
    <Compile Remove="InNascCompanyCreateForm.cs" />
    <Compile Remove="InNascGlobalAdminForm.cs" />
    <Compile Remove="InNascGlobalConfigStore.cs" />
    <Compile Remove="InNascGlobalCoreService.cs" />
    <Compile Remove="InNascGlobalModels.cs" />
    <Compile Remove="InNascGlobalSetupForm.cs" />
    <Compile Remove="InNascGlobalUserEditorForm.cs" />
    <Compile Remove="InNascMembershipForm.cs" />
    <EmbeddedResource Include="Assets\InNasc.ico"
                      LogicalName="InNasc.Assets.InNasc.ico" />
    <EmbeddedResource Include="Assets\InNascLogoLight.png"
                      LogicalName="InNasc.Assets.InNascLogoLight.png" />
    <EmbeddedResource Include="Assets\InNascLogoDark.png"
                      LogicalName="InNasc.Assets.InNascLogoDark.png" />
    <EmbeddedResource Include="Assets\InNascPrimaryHorizontal.png"
                      LogicalName="InNasc.Assets.InNascPrimaryHorizontal.png" />
    <EmbeddedResource Include="Assets\InN8LabsMascot.png"
                      LogicalName="InNasc.Assets.InN8LabsMascot.png" />
    <EmbeddedResource Include="Assets\N8LogoDark.png"
                      LogicalName="InNasc.Assets.N8LogoDark.png" />
    <EmbeddedResource Include="Assets\N8LogoLight.png"
                      LogicalName="InNasc.Assets.N8LogoLight.png" />
    <None Update="README-RUN.txt"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>

